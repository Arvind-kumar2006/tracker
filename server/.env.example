# ---- server ----
NODE_ENV=development
HOST=127.0.0.1
PORT=5555

# ---- folder ingest (PRD FR-1.3) ----
WATCH_FOLDER=..
WATCH_FOLDER_RECURSIVE=false

# ---- mongodb (system of record) ----
# Local development default. Use your own Atlas URI only in server/.env.
MONGO_URI=mongodb://127.0.0.1:27017/study_tracker
MONGO_DB_NAME=study_tracker

# ---- OpenRouter (SERVER SIDE ONLY - never ship this in the RN bundle) ----
# Optional: import and metrics work without this; AI routes return 503 until configured.
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:5555
OPENROUTER_APP_TITLE=Study Accountability Tracker
MODEL_FAST=google/gemini-2.5-flash
MODEL_STRONG=anthropic/claude-sonnet-4.6
MODEL_FAST_FALLBACK=openai/gpt-4o-mini
MODEL_STRONG_FALLBACK=google/gemini-2.5-pro
TEMP_ANALYSIS=0.2
TEMP_CREATIVE=0.6
AI_MONTHLY_BUDGET_CREDITS=0.50

# ---- Google Sheets (the human-readable mirror) ----
# Optional: leave blank unless Sheets sync is configured.
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
