{
  "name": "study-accountability-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Domain layer, AI analysis graph, and persistence for the Study Accountability Tracker",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/interface/http/server.js",
    "dev": "node --watch src/interface/http/server.js",
    "build": "node scripts/vercel-build.js",
    "test": "node --test --test-force-exit --test-concurrency=1 test/*.test.js",
    "lint:boundaries": "eslint . --ext .js",
    "verify:no-secrets": "node scripts/verify-no-secrets.js",
    "verify": "npm run lint:boundaries && npm run verify:no-secrets && npm test"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "eslint-plugin-boundaries": "^5.0.1"
  }
}
